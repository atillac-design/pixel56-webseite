# Sanity CMS — Projekt unter https://www.sanity.io/manage anlegen,
# Projekt-ID hier eintragen. Ohne diese Werte laufen alle Inhalte über
# die statischen Fallbacks in lib/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# MailerLite — API-Key unter Integrationen → Developer API erzeugen.
# Optional: Gruppen-ID, in die neue Freebie-Kontakte einsortiert werden.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
