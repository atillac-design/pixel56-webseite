# Sanity CMS — Projekt pixel56 (an8mgmdx) ist bereits im Code hinterlegt.
# Diese Variablen nur setzen, wenn Projekt/Dataset abweichen sollen.
NEXT_PUBLIC_SANITY_PROJECT_ID=an8mgmdx
NEXT_PUBLIC_SANITY_DATASET=production

# MailerLite — API-Key unter Integrationen → Developer API erzeugen.
MAILERLITE_API_KEY=

# Gruppen-Zuordnung: allgemeine Gruppe plus optional je Freebie eine
# eigene Gruppe (löst die jeweilige PDF-Versand-Automation aus).
MAILERLITE_GROUP_ID=
MAILERLITE_GROUP_SEO_CHECKLISTE=
MAILERLITE_GROUP_KI_AGENTEN_CHECKLISTE=
MAILERLITE_GROUP_TAGESPLANER=
MAILERLITE_GROUP_KONTAKTANFRAGE=
